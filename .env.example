# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security Settings
MAX_UPLOAD_SIZE_MB=15
ALLOWED_PE_EXTENSIONS=.exe,.dll,.sys,.bin

# Database
DATABASE_URL=sqlite:///./database/cyber_threat.db

# Risk Engine Weights
WEIGHT_PHISHING=0.85
WEIGHT_PHISHING_CONTEXT=0.15
WEIGHT_MALWARE=0.85
WEIGHT_MALWARE_CONTEXT=0.15
